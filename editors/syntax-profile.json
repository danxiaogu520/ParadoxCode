{
  "schema": 1,
  "language": "eu4",
  "lineComment": "#",
  "brackets": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" }
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*[{\\[]\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*[}\\]]"
  }
}
