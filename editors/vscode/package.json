{
  "name": "paradoxcode-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.2",
  "publisher": "paradoxcode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danxiaogu520/ParadoxCode"
  },
  "homepage": "https://github.com/danxiaogu520/ParadoxCode#readme",
  "bugs": {
    "url": "https://github.com/danxiaogu520/ParadoxCode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ParadoxCode downloads and runs the checksum-verified pdx-ls binary for the current platform."
    }
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "eu4",
    "europa universalis iv",
    "paradox",
    "modding",
    "language server",
    "missions"
  ],
  "activationEvents": [
    "onLanguage:eu4",
    "workspaceContains:.pdx/project.toml",
    "workspaceContains:**/common/**/*.txt",
    "workspaceContains:**/events/**/*.txt",
    "workspaceContains:**/missions/**/*.txt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "eu4",
        "aliases": [
          "Europa Universalis IV",
          "eu4"
        ],
        "configuration": "./language-configuration.json",
        "filenamePatterns": [
          "**/common/**/*.txt",
          "**/events/**/*.txt",
          "**/decisions/**/*.txt",
          "**/missions/**/*.txt",
          "**/history/**/*.txt",
          "**/interface/**/*.gui",
          "**/interface/**/*.gfx"
        ]
      }
    ],
    "grammars": [
      {
        "language": "eu4",
        "scopeName": "source.eu4",
        "path": "./syntaxes/eu4.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "paradoxcode.loadedFiles",
          "name": "%views.loadedFiles.name%",
          "when": "paradoxcodeServerRunning"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "paradoxcode.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "trustWorkspace",
            "title": "%walkthrough.trustWorkspace.title%",
            "description": "%walkthrough.trustWorkspace.description%",
            "media": {
              "markdown": "media/getting-started.md"
            },
            "when": "!isWorkspaceTrusted",
            "completionEvents": [
              "onContext:isWorkspaceTrusted"
            ]
          },
          {
            "id": "openMod",
            "title": "%walkthrough.openMod.title%",
            "description": "%walkthrough.openMod.description%",
            "media": {
              "markdown": "media/getting-started.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.files.openFolder"
            ]
          },
          {
            "id": "prepareServer",
            "title": "%walkthrough.prepareServer.title%",
            "description": "%walkthrough.prepareServer.description%",
            "media": {
              "markdown": "media/getting-started.md"
            },
            "completionEvents": [
              "onContext:paradoxcodeServerRunning"
            ]
          },
          {
            "id": "vanillaData",
            "title": "%walkthrough.vanillaData.title%",
            "description": "%walkthrough.vanillaData.description%",
            "media": {
              "markdown": "media/getting-started.md"
            },
            "when": "!paradoxcodeVanillaReady",
            "completionEvents": [
              "onContext:paradoxcodeVanillaReady"
            ]
          },
          {
            "id": "checkDiagnostics",
            "title": "%walkthrough.checkDiagnostics.title%",
            "description": "%walkthrough.checkDiagnostics.description%",
            "media": {
              "markdown": "media/getting-started.md"
            },
            "completionEvents": [
              "onCommand:paradoxcode.exportDiagnostics"
            ]
          },
          {
            "id": "missionPreview",
            "title": "%walkthrough.missionPreview.title%",
            "description": "%walkthrough.missionPreview.description%",
            "media": {
              "markdown": "media/getting-started.md"
            },
            "completionEvents": [
              "onCommand:paradoxcode.showMissionPreview"
            ]
          }
        ]
      }
    ],
    "configurationDefaults": {
      "[eu4]": {
        "editor.semanticHighlighting.enabled": true,
        "files.autoGuessEncoding": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.insertSpaces": false,
        "editor.acceptSuggestionOnEnter": "off",
        "editor.suggest.insertMode": "replace"
      }
    },
    "semanticTokenScopes": [
      {
        "language": "eu4",
        "scopes": {
          "comment": ["comment", "comment.line.number-sign"],
          "string": ["string", "string.unquoted"],
          "number": ["constant.numeric"],
          "boolean": ["constant.language.boolean"],
          "operator": ["keyword.operator"],
          "property": ["variable.other.property"],
          "function": ["support.function", "entity.name.function"],
          "keyword": ["keyword.control", "keyword"],
          "type": ["entity.name.type"],
          "variable": ["variable", "variable.other.definition"],
          "parameter": ["variable.parameter", "variable"]
        }
      }
    ],
    "commands": [
      {
        "command": "paradoxcode.showMissionPreview",
        "title": "%commands.showMissionPreview.title%",
        "category": "ParadoxCode",
        "icon": "$(open-preview)"
      },
      {
        "command": "paradoxcode.refreshMissionPreview",
        "title": "%commands.refreshMissionPreview.title%",
        "category": "ParadoxCode",
        "icon": "$(refresh)"
      },
      {
        "command": "paradoxcode.installServer",
        "title": "%commands.installServer.title%",
        "category": "ParadoxCode"
      },
      {
        "command": "paradoxcode.selectServer",
        "title": "%commands.selectServer.title%",
        "category": "ParadoxCode"
      },
      {
        "command": "paradoxcode.selectGameDirectory",
        "title": "%commands.selectGameDirectory.title%",
        "category": "ParadoxCode"
      },
      {
        "command": "paradoxcode.reloadServer",
        "title": "%commands.reloadServer.title%",
        "category": "ParadoxCode"
      },
      {
        "command": "paradoxcode.exportDiagnostics",
        "title": "%commands.exportDiagnostics.title%",
        "category": "ParadoxCode"
      },
      {
        "command": "paradoxcode.openOutput",
        "title": "%commands.openOutput.title%",
        "category": "ParadoxCode"
      },
      {
        "command": "paradoxcode.refreshLoadedFiles",
        "title": "%commands.refreshLoadedFiles.title%",
        "category": "ParadoxCode",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "paradoxcode.showMissionPreview",
          "when": "paradoxcodeMissionFile",
          "group": "navigation@1"
        },
        {
          "command": "paradoxcode.refreshMissionPreview",
          "when": "paradoxcodeMissionFile",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "paradoxcode.refreshLoadedFiles",
          "when": "view == paradoxcode.loadedFiles",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "ParadoxCode",
      "properties": {
        "paradoxcode.pdxLsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.pdxLsPath.description%"
        },
        "paradoxcode.serverInstallDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%configuration.serverInstallDirectory.description%"
        },
        "paradoxcode.projectConfig": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.projectConfig.description%"
        },
        "paradoxcode.modDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.modDirectory.description%"
        },
        "paradoxcode.vanillaIndexCache": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.vanillaIndexCache.description%"
        },
        "paradoxcode.dependencies": {
          "type": "array",
          "default": [],
          "markdownDescription": "%configuration.dependencies.description%",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "index": { "type": "string" }
            }
          }
        },
        "paradoxcode.gameDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.gameDirectory.description%"
        },
        "paradoxcode.diagnosticIgnoreCodes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "%configuration.diagnosticIgnoreCodes.description%"
        },
        "paradoxcode.diagnosticIgnoreFiles": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "%configuration.diagnosticIgnoreFiles.description%"
        },
        "paradoxcode.diagnosticLogging": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.diagnosticLogging.description%"
        },
        "paradoxcode.preview.zoomSensitivity": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1,
          "markdownDescription": "%configuration.preview.zoomSensitivity.description%"
        },
        "paradoxcode.preview.showTextures": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.preview.showTextures.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "npm run compile && node scripts/smoke.mjs",
    "vscode:prepublish": "npm run compile",
    "test:contract": "npm run compile && node scripts/extension-contract.mjs && node scripts/package-contract.mjs",
    "test:package": "vsce package --out ../../target/paradoxcode-vscode-contract.vsix",
    "test:host": "npm run compile && node scripts/host-test.mjs",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "smol-toml": "^1.4.0",
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "typescript": "^7.0.2",
    "mocha": "^10.4.0",
    "@vscode/vsce": "^3.2.2"
  },
  "files": [
    "out/**",
    "node_modules/**",
    "media/**",
    "syntaxes/**",
    "language-configuration.json",
    "package.json",
    "package.nls*.json",
    "README.md",
    "LICENSE"
  ]
}
