          "doc": "Effects executed after an option has been chosen, without repeating them in every option.",
          "override": true,
          "when": null
        },
        "desc": [
          {
            "card": "0..*",
            "doc": "Localisation key or trigger-conditional desc block for the event description.",
            "override": true,
            "value": "scalar | loc",
            "when": null
          },
          {
            "body": "event_body__desc",
            "card": "0..*",
            "doc": "Localisation key or trigger-conditional desc block for the event description.",
            "override": true,
            "when": null
          }
        ],
        "fire_only_once": {
          "card": "0..1",
          "doc": "If yes, after this event fires it will never fire again for any country, even when triggered directly in code.",
          "override": true,
          "value": "bool",
          "when": null
        },
        "goto": {
          "card": "0..1",
          "doc": "Scope-based event camera target.\nHighlights and refocuses the camera to the given province when the option is taken.",
          "override": true,
          "value": "scope<any> | ref<province_id> | ref<event_target> | ref<global_event_target> | 'root' | 'from' | ref<estate>",
          "when": null
        },
        "hidden": {
          "card": "0..1",
          "doc": "If yes, the event runs in the background without popping up for the player.",
          "override": true,
          "severity": "warning",
          "value": "'yes'",
          "when": null
        },
        "id": {
          "card": "1",
          "doc": "Unique non-negative integer event id; must not be replicated in any other event file.",
          "override": true,
          "value": "scalar",
          "when": null
        },
        "immediate": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed immediately on the event firing, before any option is chosen.",
          "override": true,
          "when": null
        },
        "is_mtth_scaled_to_size": {
          "card": "0..1",
          "override": true,
          "value": "float",
          "when": null
        },
        "is_triggered_only": [
          {
            "card": "0..1",
            "doc": "If yes, the event has no MTTH and only occurs when triggered from another source (an event or an on_action pulse).",
            "override": true,
            "value": "bool",
            "when": null
