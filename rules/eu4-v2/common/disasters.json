{
  "schemas": {
    "disaster_body": {
      "fields": {
        "can_end": {
          "body": "trigger",
          "card": "1",
          "doc": "Determines when the disaster can end once it has started (i.e. after the ticker has reached 100).",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "can_start": {
          "body": "trigger",
          "card": "1",
          "doc": "Determines whether the ticker from 0 to 100 will be enabled.",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "can_stop": {
          "body": "trigger",
          "card": "1",
          "doc": "Determines when the ticker from 0 to 100 can be disabled once enabled.",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "down_progress": {
          "body": "disaster_body__down_progress",
          "card": "0..1",
          "doc": "Sets conditions for the disaster's prgress ticker to tick downwards.",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "ended_by_country_breaking_to_rebels": {
          "card": "0..1",
          "value": "'no'"
        },
        "modifier": {
          "body": "modifier",
          "card": "0..1",
          "doc": "Modifier enabled for the country during the disaster.",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "on_end": {
          "card": "0..1",
          "doc": "Event fired when the disaster ends (after having officially started).",
          "value": "ref<event.country>"
        },
        "on_monthly": {
          "body": "disaster_body__on_monthly",
          "card": "0..1",
          "doc": "Events triggered monthly after the disaster has fired (i.e. between on_start and on_end)."
        },
        "on_progress_effect": {
          "body": "effect",
          "card": "0..1",
          "doc": "triggered monthly when it is ticking up to 100. The progress is saved in a variable that is <disaster key>_progress"
        },
        "on_start": {
          "card": "0..1",
          "doc": "Event fired on the disaster's progress reaching 100 and the disaster officially starting.",
          "value": "ref<event.country>"
        },
        "on_start_effect": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed when the disaster reaches 100% progress and happens."
        },
        "potential": {
          "body": "trigger",
          "card": "1",
          "doc": "Determines whether the disaster is visible.",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "progress": {
          "body": "modifier_rule",
          "card": "1",
          "doc": "Sets conditions for the disaster's prgress ticker to tick upwards.",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "stability_hit_on_war": {
          "card": "0..1",
          "value": "int[1..6]"
        }
      }
    },
    "disaster_body__down_progress": {
      "fields": {
        "factor": {
          "card": "1",
          "doc": "Base weight multiplier in the enclosing weight/AI block.",
          "override": true,
          "value": "float"
        }
      },
      "include": [
        "keys__modifier_rule"
      ]
    },
    "disaster_body__empty": {},
    "disaster_body__on_monthly": {
      "fields": {
        "events": {
          "body": "disaster_body__empty",
          "card": "0..1"
        },
        "random_events": {
          "body": "disaster_body__on_monthly__random_events",
          "card": "0..1"
        }
      }
    },
    "disaster_body__on_monthly__events": {
      "items": "ref<event.country>"
    },
    "disaster_body__on_monthly__random_events": {
      "patterns": [
        {
          "card": "0..*",
          "key": "scalar",
          "value": "'0' | ref<event.country>"
        }
      ]
    }
  }
}
