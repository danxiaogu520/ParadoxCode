    "great_project_body__tier_0__conditional_modifier": {
      "fields": {
        "is_bad": {
          "doc": "Specifies whether the tooltip should list it as positive or not",
          "value": "bool",
          "when": null
        },
        "modifier": {
          "body": "modifier",
          "card": "1",
          "doc": "Block of modifiers applied while the containing entry is active.",
