{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "pdx_eu4_localisation",
  "word": "localisation_key",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "bom"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "language_header"
              },
              {
                "type": "SYMBOL",
                "name": "entry"
              },
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "SYMBOL",
                "name": "newline"
              }
            ]
          }
        }
      ]
    },
    "bom": {
      "type": "STRING",
      "value": "﻿"
    },
    "language_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "language",
          "content": {
            "type": "SYMBOL",
            "name": "language_identifier"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "language_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "l_[A-Za-z0-9_]+"
      }
    },
    "entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "localisation_key"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": ":"
                },
                {
                  "type": "FIELD",
                  "name": "version",
                  "content": {
                    "type": "SYMBOL",
                    "name": "version"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "localisation_string"
              },
              {
                "type": "SYMBOL",
                "name": "unquoted_value"
              }
            ]
          }
        }
      ]
    },
    "localisation_key": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z0-9_$.-]+"
      }
    },
    "version": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]+"
      }
    },
    "localisation_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              },
              {
                "type": "SYMBOL",
                "name": "parameter_substitution"
              },
              {
                "type": "SYMBOL",
                "name": "scope_reference"
              },
              {
                "type": "SYMBOL",
                "name": "colour_tag"
              },
              {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\"\\\\$\\[§\\r\\n]+"
                }
              },
              {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[$\\[§]"
                }
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "escape_sequence": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\\\[^\\r\\n]"
      }
    },
    "parameter_substitution": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\$[^$\\r\\n]+\\$"
      }
    },
    "scope_reference": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\[[^\\]\\r\\n]+\\]"
      }
    },
    "colour_tag": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "§[A-Za-z0-9]"
      }
    },
    "unquoted_value": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^ \\t\\r\\n#][^\\r\\n#]*"
        }
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[^\\r\\n]*"
      }
    },
    "newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}