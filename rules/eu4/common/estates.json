        },
        "on_invalid": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed upon the privilege being removed due to invalidity (is_valid becomes false or the estate is removed)"
        },
        "on_invalid_province": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed upon the privilege being removed due to invalidity (is_valid becomes false or the estate is removed)",
          "scope": {
            "set": {
              "this": "province"
            }
          }
        },
        "on_revoked": {
