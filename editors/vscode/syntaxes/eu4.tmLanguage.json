{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Europa Universalis IV",
  "scopeName": "source.eu4",
  "fileTypes": ["txt", "gui", "gfx"],
  "//": "Fallback highlighting only: scopes here must match the pdx-ls semanticTokenScopes mapping in package.json so colours are stable before and after the server is ready. The only intended difference is rule-known keys and indexed scripted macro names, which the semantic layer upgrades from property to function (support.function).",
  "patterns": [
    { "include": "#comment" },
    { "include": "#quoted-key" },
    { "include": "#string" },
    { "include": "#variable" },
    { "include": "#parameter" },
    { "include": "#boolean" },
    { "include": "#number" },
    { "include": "#key" },
    { "include": "#header" },
    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#bare" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.number-sign.eu4", "match": "#.*$" }
      ]
    },
    "quoted-key": {
      "patterns": [
        {
          "name": "variable.other.property.eu4",
          "match": "(\"(?:[^\"\\\\]|\\\\.)*\")(?=\\s*=)"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.eu4",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.eu4", "match": "\\\\." }
      ]
    },
    "variable": {
      "patterns": [
        { "name": "variable.other.definition.eu4", "match": "@[A-Za-z_][A-Za-z0-9_.-]*" }
      ]
    },
    "parameter": {
      "patterns": [
        { "name": "variable.parameter.eu4", "match": "\\$[A-Za-z_][A-Za-z0-9_.-]*\\$" }
      ]
    },
    "boolean": {
      "patterns": [
        { "name": "constant.language.boolean.eu4", "match": "\\b(?:yes|no|true|false)\\b" }
      ]
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.eu4", "match": "(?<![A-Za-z0-9_.-])-?\\b[0-9]+(?:\\.[0-9]+)?\\b" }
      ]
    },
    "key": {
      "patterns": [
        {
          "name": "variable.other.property.eu4",
          "match": "(^|[\\[{;\\s])([A-Za-z_][A-Za-z0-9_.-]*)(?=\\s*=)"
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "name": "entity.name.type.eu4",
          "match": "(^|[\\[{;\\s])([A-Za-z_][A-Za-z0-9_.-]*)(?=\\s*\\{)"
        }
      ]
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.assignment.eu4", "match": "(?:=|<|>)" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.block.begin.eu4", "match": "[\\[{]" },
        { "name": "punctuation.section.block.end.eu4", "match": "[\\]}]" }
      ]
    },
    "bare": {
      "patterns": [
        { "name": "string.unquoted.eu4", "match": "\\b[A-Za-z_][A-Za-z0-9_.-]*\\b" }
      ]
    }
  }
}
