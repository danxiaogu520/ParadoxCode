          "doc": "Alternative naming of estates"
        },
        "icon": {
          "card": "1",
          "value": "int"
        },
        "independence_government": {
          "card": "0..1",
          "doc": "Used for when declaring independence",
          "value": "ref<government>"
        },
        "independence_tech_group": {
          "card": "0..1",
          "value": "ref<technology_group>"
        },
        "independence_trigger": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Used for when declaring independence",
          "scope": {
            "set": {
              "root": "province",
              "this": "province"
            }
          }
        },
        "influence_from_dev_modifier": {
          "card": "0..1",
          "value": "float"
        },
        "influence_modifier": {
          "body": "estate_body__influence_modifier",
          "card": "0..*"
        },
        "land_ownership_modifier": {
          "body": "modifier",
          "card": "1",
          "doc": "These scale with loyalty & power"
        },
        "loyalty_modifier": {
          "body": "estate_body__loyalty_modifier",
          "card": "0..*"
        },
        "other_religion_group_only": {
          "card": "0..1",
          "value": "'yes'"
        },
        "privileges": {
          "card": "0..1",
          "list": "ref<estate_privilege>"
        },
        "province_independence_weight": {
          "body": "estate_body__province_independence_weight",
          "card": "1",
          "doc": "For each province bordering another country, the neighboring provinces with the highest weights are added, until (share of land ownership * total development) is reached. From all these tries (It will do 32 of the highest weight border provinces at most), the result with the highest total sum of weights is then selected and these provinces then become the new country.",
          "scope": {
            "set": {
              "root": "province",
              "this": "province"
            }
          }
        },
        "starting_reform": {
          "card": "0..1",
          "value": "ref<government_reform>"
        },
        "trigger": {
          "body": "trigger",
          "card": "1",
          "doc": "If true, country will get estate",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        }
      }
    },
    "estate_body__agendas": {
      "items": "ref<estate_agenda>"
    },
    "estate_body__color": {
