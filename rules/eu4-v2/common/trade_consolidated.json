{
  "mixins": {
    "keys__type_trade_good": {
      "fields": {
        "is_latent": {
          "card": "0..1",
          "value": "'yes'",
          "when": null
        }
      }
    }
  },
  "schemas": {
    "prices_body": {
      "patterns": [
        {
          "card": "1..*",
          "key": "ref<trade_good>",
          "map": {
            "body": "prices_body__trade_good",
            "key": "def<trade_good>"
          },
          "when": null
        }
      ]
    },
    "prices_body__trade_good": {
      "fields": {
        "base_price": {
          "card": "1",
          "doc": "base price in $. (default is 1.0 if not specified",
          "override": true,
          "value": "float",
          "when": null
        },
        "goldtype": {
          "card": "0..1",
          "doc": "This resource works like 'gold' if yes, using prices from mine-value in province instead of supply/demand and baseprice. Also creates gold-inflation",
          "override": true,
          "value": "'yes'",
          "when": null
        }
      },
      "include": [
        "keys__type_trade_good"
      ]
    },
    "trade_center_body": {
      "fields": {
        "cost": {
          "card": "0..1",
          "value": "int",
