# Rust and native build outputs
**/target/
*.pdb
*.dSYM/
*.profraw
*.profdata

# Tree-sitter / JavaScript tooling
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/__pycache__/
*.py[cod]

# Machine-local editor and agent state
/.cargo/
/.zed/
/.agents/
/.codex/
/.codex-toml-check/
/.mimocode/

# Generated Zed extension assets
/editors/zed/extension.wasm
/editors/zed/grammars/
/editors/zed/bundled-rules/*.pdxrules

# Local indexes, caches, and generated rule artifacts
*.pdxindex
**/.pdx/cache/
/rules/vanilla-cache/
/rules/*.pdxrules

# Generated whole-Current-Mod diagnostic reports
**/diagnostic-reports/

# Temporary local rule-inspection helper
/rules/find-rule.cjs

# OS and editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Fuzzing crash artifacts (keep regression corpus trackable)
/fuzz/artifacts/

# External CWTools reference material
/reference/
