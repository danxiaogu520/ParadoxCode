# Rust build output
**/target/
*.pdb
*.wasm

# Language-tool build caches
**/node_modules/
**/__pycache__/
*.py[cod]

# Machine-local tool and editor configuration
/.cargo/
/.zed/
.DS_Store
Thumbs.db

# Zed clones and compiles development grammars into this directory.
/editors/zed/grammars/

# Local indexes and generated runtime artifacts
*.pdxindex
**/.pdx/cache/
/rules/vanilla-cache/
/editors/zed/bundled-rules/*.pdxrules

# The audited EU4 artifact is the only pdxrules file kept in source control.
/rules/*.pdxrules
!/rules/eu4.pdxrules

# CWTools reference
/reference/

# Deprecated tests
/tests/
