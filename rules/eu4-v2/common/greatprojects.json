          "card": "1",
          "doc": "tier data",
          "override": true,
          "when": null
        },
        "time": {
          "body": "great_project_body__time",
          "card": "1",
          "doc": "time to build",
          "override": true,
          "when": null
        },
        "type": {
          "card": "1",
          "doc": "project type",
          "override": true,
          "value": "'monument' | 'canal'",
          "when": null
        }
      },
      "include": [
        "keys__type_great_project"
      ]
    },
    "great_project_body__on_built": {
      "fields": {
        "add_canal": {
          "override": true,
          "value": "ref<great_project.canal>",
          "when": null
        },
        "show_ambient_object": {
          "card": "0..2",
          "override": true,
          "value": "ref<great_project> | ref<ambient_object>",
          "when": null
        }
      },
      "include": [
        "keys__effect"
      ]
    },
    "great_project_body__on_destroyed": {
      "fields": {
        "hide_ambient_object": {
          "card": "0..2",
          "override": true,
          "value": "ref<great_project> | ref<ambient_object>",
          "when": null
        },
        "remove_canal": {
          "override": true,
          "value": "ref<great_project.canal>",
          "when": null
        }
