{
  "schemas": {
    "estate_agenda_body": {
      "fields": {
        "can_select": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Conditions for whether the agenda can be offered to you"
        },
        "fail_if": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Conditions for when the agenda should be auto-failed"
        },
        "failing_effect": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed when the agenda is failed (i.e. when fail_if is true or time runs out)"
        },
        "immediate_effect": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed when the agenda is accepted by the country"
        },
        "invalid_trigger": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Conditions for when the agenda should end without it counting as a fail (executing on_invalid rather than failing_effect). Happens by default it the estate giving the agenda is removed."
        },
        "max_days_active": {
          "card": "0..1",
          "doc": "Lets you override the default of 20 years for an agenda",
          "value": "int"
        },
        "modifier": {
          "body": "modifier",
          "card": "0..1",
          "doc": "Country modifier granted while the agenda is active"
        },
        "on_invalid": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed when the country no longer has that estate or the invalid_trigger is true. Useful for clearing flags, modifiers etc."
        },
        "pre_effect": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed to set up the task (set flags and targets), before it is shown to the player."
        },
        "provinces_to_highlight": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Conditions for provinces to be highlighted by the agenda. Root = country, this = province.",
          "scope": {
            "push": "province"
          }
        },
        "selection_weight": {
          "body": "estate_agenda_body__selection_weight",
          "card": "0..1",
          "doc": "Determines how likely (compared to the estate's other agendas) this agenda is to be selected. Initial factor will ignore numbers below 1, use a modifier for that!"
        },
        "task_completed_effect": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed when the agenda is successfully completed"
        },
        "task_requirements": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Conditions for completing the task successfully"
        }
      }
    },
    "estate_agenda_body__selection_weight": {
      "fields": {
        "factor": {
          "card": "1",
          "doc": "Base weight multiplier in the enclosing weight/AI block.",
          "override": true,
          "value": "float[1.0..]"
        }
      },
      "include": [
        "keys__modifier_rule"
      ]
    },
    "estate_body": {
      "fields": {
        "agendas": {
          "card": "0..1",
          "list": "ref<estate_agenda>"
        },
        "base_influence": {
          "card": "1",
          "value": "int"
        },
        "color": {
          "card": "1",
          "list": "int[0..]"
        },
        "contributes_to_curia_treasury": {
          "card": "0..1",
          "value": "'yes'"
        },
        "country_modifier_angry": {
          "body": "modifier",
          "card": "1",
          "doc": "These scale with loyalty & power"
        },
        "country_modifier_happy": {
          "body": "modifier",
          "card": "1",
          "doc": "These scale with loyalty & power"
        },
        "country_modifier_neutral": {
          "body": "modifier",
          "card": "1",
          "doc": "These scale with loyalty & power"
        },
        "custom_desc": {
          "body": "estate_body__custom_desc",
