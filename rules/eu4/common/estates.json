    "estate_privilege_body": {
      "fields": {
        "additional_description": {
          "card": "0..1",
          "doc": "You can put static modifier names here as well as normal localisation keys",
          "list": "'cossacks_regiment' | 'rajput_regiment' | scalar"
        },
        "ai_will_do": {
          "body": "estate_privilege_body__ai_will_do",
          "card": "1",
          "doc": "AI weighting block: factor = base weight, modifier blocks adjust it."
        },
        "benefits": {
          "body": "modifier",
          "card": "0..1",
          "doc": "Positive modifiers granted while the privilege is active (creates different tooltip to penalties)"
        },
        "can_revoke": [
          {
            "card": "0..1",
            "doc": "Conditions for whether it is possible for the country to revoke this privilege",
            "value": "bool"
          },
          {
            "body": "trigger",
            "card": "0..1",
            "doc": "Conditions for whether the country can revoke the privilege"
          }
        ],
        "can_select": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Conditions for whether the country is allowed to select the privilege (with conditions for why not displayed)"
        },
        "check_valid_when_tag_switching": {
          "card": "0..1",
          "doc": "Defaults to yes",
          "value": "'no'"
        },
        "conditional_modifier": {
          "body": "estate_privilege_body__conditional_modifier",
          "card": "0..*",
          "doc": "Modifier that are applied if the specified conditions are true."
        },
        "cooldown_years": {
          "card": "0..1",
          "doc": "Time limit before which the privilege cannot be revoked",
          "value": "int"
        },
        "icon": {
          "card": "1",
          "value": "scalar"
        },
        "influence": {
          "card": "0..1",
          "value": "float[-0.95..0.95]"
        },
        "influence_scaled_conditional_modifier": {
          "body": "estate_privilege_body__influence_scaled_conditional_modifier",
          "card": "0..*",
          "doc": "Modifier that are applied if the specified conditions are true. At 100% Influence you gain 100% of the modifier."
        },
        "is_valid": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Conditions for whether it is possible for the country to have this privilege (it will not display on the list if they are false, and will be revoked if it has already been granted)"
        },
        "land_share": {
          "card": "0..1",
          "value": "int"
        },
        "loyalty": {
          "card": "0..1",
          "value": "float[-0.95..0.95]"
        },
        "loyalty_scaled_conditional_modifier": {
          "body": "estate_privilege_body__loyalty_scaled_conditional_modifier",
          "card": "0..*",
          "doc": "Modifier that is applied if specified conditions are true, with its effect scaling on the loyalty of the estate"
        },
        "max_absolutism": {
          "card": "0..1",
          "value": "int"
        },
        "mechanics": {
          "body": "estate_privilege_body__empty",
          "card": "0..1",
          "doc": "Special mechanics the privilege enables"
        },
        "modifier_by_land_ownership": {
          "body": "modifier",
          "card": "0..1",
          "doc": "Multiplies the modifier by the % of land owned by the estate."
        },
        "on_cooldown_expires": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effect executed once the specified cooldown_years timer has run down"
        },
        "on_granted": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed immediately upon the privilege being taken"
        },
        "on_granted_province": {
          "body": "effect",
          "card": "0..1",
          "doc": "Effects executed immediately upon the privilege being taken",
          "scope": {
            "set": {
              "this": "province"
