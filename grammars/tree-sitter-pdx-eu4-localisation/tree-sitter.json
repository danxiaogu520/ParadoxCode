{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pdx_eu4_localisation",
      "camelcase": "PdxEu4Localisation",
      "title": "EU4 Localisation",
      "scope": "source.pdx_eu4_localisation",
      "file-types": ["yml"],
      "injection-regex": "^pdx[-_ ]?eu4[-_ ]?localisation$",
      "class-name": "TreeSitterPdxEu4Localisation"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for EU4 localisation"
  },
  "bindings": {
    "c": true,
    "node": true,
    "rust": true
  }
}
