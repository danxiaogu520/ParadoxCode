{
  "mixins": {
    "keys__type_great_project": {
      "fields": {
        "type": {
          "card": "1",
          "value": "'monument' | 'canal'",
          "when": null
        }
      }
    }
  },
  "schemas": {
    "great_project_body": {
      "fields": {
        "build_cost": {
          "card": "1",
          "doc": "how much to build one",
          "override": true,
          "value": "int",
          "when": null
        },
        "build_trigger": {
          "body": "trigger",
          "card": "1",
          "doc": "can we build it?",
          "override": true,
          "scope": {
            "set": {
              "from": "country",
              "root": "province",
              "this": "province"
            }
          },
          "when": null
        },
        "can_be_moved": {
          "card": "1",
          "doc": "can we move it?",
          "override": true,
          "value": "bool",
          "when": null
        },
        "can_upgrade_trigger": {
          "body": "trigger",
          "card": "1",
          "doc": "can our country upgrade it?",
          "override": true,
          "scope": {
            "set": {
              "from": "country",
              "root": "province",
              "this": "province"
            }
          },
          "when": null
        },
        "can_use_modifiers_trigger": {
          "body": "trigger",
          "card": "1",
          "doc": "can our country use it?",
          "override": true,
          "scope": {
            "set": {
              "from": "country",
              "root": "province",
              "this": "province"
            }
          },
          "when": null
        },
        "date": {
          "card": "1",
          "doc": "date built in real life (so anything built during game time will be there if you start a game after that date)",
          "override": true,
          "value": "scalar",
          "when": null
        },
        "keep_trigger": {
          "body": "trigger",
          "card": "1",
          "doc": "can our country keep it or is it destroyed when we get hold of it?",
          "override": true,
          "scope": {
            "set": {
              "from": "country",
              "root": "province",
              "this": "province"
            }
          },
          "when": null
        },
        "move_days_per_unit_distance": {
          "doc": "time to move the project one unit of distance, in days",
          "override": true,
          "value": "int",
          "when": null
        },
        "on_built": {
          "body": "great_project_body__on_built",
          "doc": "what to do when it's built",
          "override": true,
          "scope": {
            "set": {
              "from": "country",
              "root": "province",
              "this": "province"
            }
          },
          "when": null
        },
        "on_destroyed": {
          "body": "great_project_body__on_destroyed",
          "doc": "what to do when it's destroyed",
          "override": true,
          "scope": {
            "set": {
              "from": "country",
              "root": "province",
              "this": "province"
            }
          },
          "when": null
        },
        "start": {
          "card": "1",
          "doc": "province it starts in",
          "override": true,
          "value": "int",
          "when": null
        },
        "starting_tier": {
          "card": "1",
          "doc": "tier that the project starts at when first placed in the game (be that at game start or when built by a country as the game progresses)",
          "override": true,
          "value": "int",
          "when": null
        },
        "tier_0": {
          "body": "great_project_body__tier_0",
          "card": "1",
          "doc": "tier data",
          "override": true,
          "when": null
        },
        "tier_1": {
          "body": "great_project_body__tier_1",
          "card": "1",
          "doc": "tier data",
          "override": true,
          "when": null
        },
        "tier_2": {
          "body": "great_project_body__tier_2",
          "card": "1",
          "doc": "tier data",
          "override": true,
