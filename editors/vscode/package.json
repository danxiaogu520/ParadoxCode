  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "npm run compile && node scripts/smoke.mjs",
    "test:ci": "npm run compile && node scripts/smoke.mjs && node scripts/extension-contract.mjs && node scripts/package-contract.mjs && npm run test:package",
    "vscode:prepublish": "npm run compile",
    "test:contract": "npm run compile && node scripts/extension-contract.mjs && node scripts/package-contract.mjs",
    "test:package": "vsce package --out ../../target/paradoxcode-vscode-contract.vsix",
    "test:host": "npm run compile && node scripts/host-test.mjs",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.2",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  },
  "files": [
