{
  "schemas": {
    "prices_body": {
      "patterns": [
        {
          "body": "prices_body__trade_good",
          "card": "1..*",
          "key": "ref<trade_good>"
        }
      ]
    },
    "prices_body__trade_good": {
      "fields": {
        "base_price": {
          "card": "1",
          "doc": "base price in $. (default is 1.0 if not specified",
          "override": true,
          "value": "float"
        },
        "goldtype": {
          "card": "0..1",
          "doc": "This resource works like 'gold' if yes, using prices from mine-value in province instead of supply/demand and baseprice. Also creates gold-inflation",
          "override": true,
          "value": "'yes'"
        },
        "is_latent": {
          "card": "0..1",
          "value": "'yes'"
        }
      }
    },
    "trade_center_body": {
      "fields": {
        "cost": {
          "card": "0..1",
          "value": "int"
        },
        "development": {
          "card": "0..1",
          "value": "int"
        },
        "global_modifiers": {
          "body": "modifier",
          "card": "0..1",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "level": {
          "card": "1",
          "value": "int"
        },
        "province_modifiers": {
          "body": "modifier",
          "card": "0..1",
          "scope": {
            "set": {
              "root": "province",
              "this": "province"
            }
          }
        },
        "state_modifiers": {
          "body": "modifier",
          "card": "0..1",
          "scope": {
            "set": {
              "root": "province",
              "this": "province"
            }
          }
        },
        "type": {
          "card": "1",
          "value": "enum<trade_center_types>"
        }
      }
    },
    "trade_company_body": {
      "fields": {
        "color": {
          "card": "1",
          "list": "int[0..255]"
        },
        "names": {
          "body": "trade_company_body__names",
          "card": "1..*"
        },
        "provinces": {
          "card": "1",
          "list": "ref<province_id>"
