{
  "schemas": {
    "advisor_type_body": {
      "fields": {
        "ai_will_do": {
          "body": "advisor_type_body__ai_will_do",
          "card": "1",
          "doc": "AI weighting block: factor = base weight, modifier blocks adjust it.",
          "scope": {
            "set": {
              "root": "country",
              "this": "country"
            }
          }
        },
        "allow_only_female": {
          "card": "0..1",
          "value": "'yes'"
        },
        "allow_only_male": {
          "card": "0..1",
          "value": "'yes'"
        },
        "allow_only_owner_religion": {
          "card": "0..1",
          "value": "'yes'"
        },
        "chance": {
          "body": "advisor_type_body__chance",
          "card": "1",
          "scope": {
            "set": {
              "root": "province",
              "this": "province"
            }
          }
        },
        "monarch_power": {
          "card": "1",
          "value": "enum<power_categories>"
        },
        "skill_scaled_modifier": {
          "body": "advisor_type_body__skill_scaled_modifier",
          "card": "0..*",
          "doc": "Modifier scales by level of advisor, applies if trigger is true"
        }
      },
      "include": [
        "keys__modifier"
      ],
      "patterns": [
        {
          "card": "0..*",
          "doc": "Modifies the monthly gain of power for this mechanic power",
          "key": "'monthly_{ref<government_mechanic_power>}'",
          "scope": {
            "in": [
              "country"
            ]
          },
          "value": "float"
        },
        {
          "card": "0..*",
          "doc": "Modifies the influence of the specified estate.",
          "key": "'{ref<estate strip_prefix estate_>}_influence_modifier'",
          "scope": {
            "in": [
              "country"
            ]
          },
          "value": "float"
        },
        {
          "card": "0..*",
          "doc": "Modifies the loyalty of the specified estate.",
          "key": "'{ref<estate strip_prefix estate_>}_loyalty_modifier'",
          "scope": {
            "in": [
              "country"
            ]
          },
          "value": "float"
        },
        {
          "card": "0..*",
          "doc": "Adds to the number of privilege slots of the specified estate.",
          "key": "'{ref<estate strip_prefix estate_>}_privilege_slots'",
          "scope": {
            "in": [
              "country"
            ]
          },
          "value": "float"
        },
        {
          "card": "0..*",
          "doc": "Adds to the monthly rate of faction influence; generated for all factions in common/factions.",
          "key": "'{ref<faction>}_influence'",
          "scope": {
            "in": [
              "country"
            ]
          },
          "value": "float"
        },
        {
          "card": "0..*",
          "doc": "Modifies the gain from the add_government_power effect",
          "key": "'{ref<government_mechanic_power>}_gain_modifier'",
          "scope": {
            "in": [
              "country"
            ]
          },
          "value": "float"
        },
        {
          "card": "0..1",
          "key": "ref<estate_modifier>",
          "scope": {
            "in": [
              "country"
            ]
          },
          "value": "float"
        }
      ]
    },
    "advisor_type_body__ai_will_do": {
      "fields": {
        "factor": {
          "card": "1",
          "doc": "Base weight multiplier in the enclosing weight/AI block.",
          "override": true,
          "value": "float"
        }
      },
      "include": [
        "keys__modifier_rule"
      ]
    },
    "advisor_type_body__chance": {
      "fields": {
        "factor": {
          "card": "1",
          "doc": "Base weight multiplier in the enclosing weight/AI block.",
          "override": true,
          "value": "float"
        }
      },
      "include": [
        "keys__modifier_rule"
      ]
    },
    "advisor_type_body__skill_scaled_modifier": {
      "fields": {
        "modifier": {
          "body": "modifier",
          "card": "1",
          "doc": "Block of modifiers applied while the containing entry is active."
        },
        "trigger": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Block of trigger conditions; all must hold for the containing entry to apply.",
          "scope": {
            "set": {
              "this": "province"
            }
          }
        }
      }
    }
  }
}
