        "position": {
          "card": "1",
          "list": "float",
          "when": null
        },
        "rotation": {
          "card": "1",
          "list": "float",
          "when": null
        }
      }
    },
    "province_id_body__height": {
      "items": "float"
    },
    "province_id_body__position": {
      "items": "float"
    },
    "province_id_body__rotation": {
      "items": "float"
    },
