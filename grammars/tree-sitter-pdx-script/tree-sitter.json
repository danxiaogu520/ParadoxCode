{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pdx_script",
      "camelcase": "PdxScript",
      "title": "EU4 PdxScript",
      "scope": "source.pdx_script",
      "file-types": ["txt", "gui", "gfx"],
      "injection-regex": "^pdx[-_ ]?script$",
      "class-name": "TreeSitterPdxScript"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for EU4 PdxScript"
  },
  "bindings": {
    "c": true,
    "node": true,
    "rust": true
  }
}
