# Rust build output
**/target/
*.pdb
*.wasm

# Language-tool build caches
**/node_modules/
**/__pycache__/
*.py[cod]

# Machine-local tool and editor configuration
/.cargo/
/.zed/
/.agents/
/.codex/

# Ignore all dot-directories created by editors and local tools.
**/.*/

.DS_Store
Thumbs.db

# Zed clones and compiles development grammars into this directory.
/editors/zed/grammars/

# Local indexes and generated runtime artifacts
*.pdxindex
**/.pdx/cache/
/rules/vanilla-cache/
/editors/zed/bundled-rules/*.pdxrules

# Rule artifacts are generated in user/release caches from the first-party JSON source.
/rules/*.pdxrules

# Temporary local rule-inspection helper
/rules/find-rule.cjs

# CWTools reference
/reference/
