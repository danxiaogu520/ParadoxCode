          "card": "0..1",
          "doc": "\"Kind of on average how many provinces we want to spawn with it.\"",
          "override": true,
          "value": "int"
        },
        "trigger": {
          "body": "trigger",
          "card": "0..1",
          "doc": "Block of trigger conditions; all must hold for the containing entry to apply.",
